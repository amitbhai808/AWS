# ──────────────────────────────────────────────────────────────────────────
# Vault v0.1-beta — Environment Configuration
# ──────────────────────────────────────────────────────────────────────────
# Copy to `.env` and customise.
#
#   cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────
# SQLite (default, zero-config)
DATABASE_URL=sqlite+aiosqlite:///./vault_metadata.db
NEON_DB_API =napi_k6yp3ew4q9ppeycaae74v1eag5g8cgx2yhkp105ny65i6wc8ytoluv7sllzz1r7x
# PostgreSQL (uncomment to use)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vault_db

# ── Coordinator ───────────────────────────────────────────────────────────
COORDINATOR_PORT=8000

# ── Storage nodes ─────────────────────────────────────────────────────────
NODE_HOST=localhost
NODE_PORTS=[8001,8002,8003,8004]

# Explicit URLs (overrides NODE_HOST + NODE_PORTS when set)
# STORAGE_NODES=["http://storage-1:8001","http://storage-2:8001","http://storage-3:8001"]

# ── Chunking & replication ────────────────────────────────────────────────
CHUNK_SIZE=4194304
REPLICATION_FACTOR=3
VIRTUAL_NODES=100
HEARTBEAT_INTERVAL_SECONDS=3
NODE_TIMEOUT_SECONDS=2.0
